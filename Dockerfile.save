FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

# --------------------------------------------------
# System dependencies and Python 3.11
# --------------------------------------------------

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    ca-certificates \
    git \
    build-essential \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    libsndfile1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*


RUN apt-get update && \
    apt-get install -y software-properties-common && \
    add-apt-repository -y ppa:deadsnakes/ppa
# Python 3.11 pip
RUN python3.11 -m ensurepip --upgrade || true

RUN python3.11 -m pip install --upgrade pip setuptools wheel

# Make Python 3.11 the default Python command
RUN ln -sf /usr/bin/python3.11 /usr/local/bin/python && \
    ln -sf /usr/local/bin/python /usr/local/bin/python3

# --------------------------------------------------
# PyTorch with CUDA 12.1
# --------------------------------------------------

RUN python -m pip install \
    torch==2.5.1 \
    torchaudio==2.5.1 \
    --index-url https://download.pytorch.org/whl/cu121

# --------------------------------------------------
# Project requirements
# --------------------------------------------------

COPY SW/requirements.txt /tmp/requirements.txt

RUN printf "torch==2.5.1\ntorchaudio==2.5.1\nsympy==1.13.1\n" \
    > /tmp/constraints.txt && \
    grep -vE '^(torch|torchaudio|torchvision|nvidia-|triton|cuda-|sympy)' \
    /tmp/requirements.txt > /tmp/req_clean.txt && \
    python -m pip install -c /tmp/constraints.txt -r /tmp/req_clean.txt

# --------------------------------------------------
# Workspace
# --------------------------------------------------

WORKDIR /workspace

CMD ["/bin/bash"]
